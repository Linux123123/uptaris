# Backend
APP_ENV=development
API_HOST=127.0.0.1
API_PORT=8080
DATABASE_URL=postgres://uptaris:uptaris@localhost:5432/uptaris?sslmode=disable
SENTRY_DSN=
CORS_ORIGINS=http://localhost:5173
FRONTEND_URL=http://localhost:5173
WEBAUTHN_RP_ID=localhost
JWT_ACCESS_SECRET=development-only-change-me
REFRESH_TOKEN_PEPPER=development-only-change-me
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=720h
COOKIE_SECURE=false
# Use none only for truly cross-site frontend/API; requires secure HTTPS cookies.
COOKIE_SAME_SITE=lax
# Comma-separated reverse-proxy IPs/CIDRs; empty means forwarded IP headers untrusted.
TRUSTED_PROXIES=
# Comma-separated configured OAuth adapters and their client settings.
OAUTH_PROVIDERS=
OAUTH_GITHUB_CLIENT_ID=
OAUTH_GITHUB_CLIENT_SECRET=
OAUTH_GITHUB_REDIRECT_URL=
OAUTH_GOOGLE_CLIENT_ID=
OAUTH_GOOGLE_CLIENT_SECRET=
OAUTH_GOOGLE_REDIRECT_URL=
# Required with OAuth providers: persistent 32-byte key encoded as 64 hex characters.
OAUTH_TOKEN_ENCRYPTION_KEY=
# Required for authenticator enrollment/verification: separate persistent 32-byte key in hex.
# Keep stable and back it up; changing it prevents authenticator verification.
TWO_FACTOR_ENCRYPTION_KEY=

# Frontend
VITE_API_URL=http://localhost:8080/api/v1
