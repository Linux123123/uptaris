# Shared development configuration. Copy to .env and replace when needed.
APP_ENV=development
API_HOST=127.0.0.1
API_PORT=8080
DATABASE_URL=postgres://uptaris:uptaris@localhost:5432/uptaris?sslmode=disable
SENTRY_DSN=
# Production: https://uptaris.linux123123.com
CORS_ORIGINS=http://localhost:5173
# Production: https://uptaris-api.linux123123.com/api/v1
VITE_API_URL=http://localhost:8080/api/v1
JWT_ACCESS_SECRET=development-only-change-me
REFRESH_TOKEN_PEPPER=development-only-change-me
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=720h
COOKIE_SECURE=false
# Use none only for truly cross-site frontend/API; requires secure HTTPS cookies.
COOKIE_SAME_SITE=lax
# Comma-separated reverse-proxy IPs/CIDRs; empty means forwarded IP headers untrusted.
TRUSTED_PROXIES=
